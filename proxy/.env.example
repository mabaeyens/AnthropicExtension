# Configuración del proxy — copia a .env y ajusta los valores:
#     cp .env.example .env

# Clave de API de Anthropic — la mantiene el PROXY, nunca el navegador (P01).
# OBLIGATORIA: el proxy no arranca sin ella / Required: the proxy will not start without it.
ANTHROPIC_API_KEY=

# Origen permitido por CORS (tu servidor Qlik Sense)
QLIK_ORIGIN=https://your-qlik-server

# Autenticación del llamante (P02) — el proxy valida la sesión Qlik del navegador
# contra la API de Qlik (QPS) por TLS mutuo, y resuelve la identidad del usuario.
# OBLIGATORIAS para /api/*: el proxy no arranca sin ellas.
QLIK_SESSION_URL=https://your-qlik-server:4243/qps/session   # endpoint de sesión QPS
QLIK_CERT=./certs/client.pem                                  # certificado de cliente Qlik
QLIK_KEY=./certs/client_key.pem                               # clave privada del certificado
QLIK_CA=./certs/root.pem                                      # CA de Qlik (opcional)
# TTL de la caché de validaciones positivas (ms). Opcional; por defecto 60000.
# QLIK_AUTH_CACHE_TTL_MS=60000

# Puerto del proxy (por defecto 3000)
PORT=3000

# URL del servidor Ollama local (endpoint compatible con OpenAI) para el modelo local.
# Usado por la ruta /api/ollama. Por defecto: http://localhost:11434/v1/chat/completions
OLLAMA_URL=http://localhost:11434/v1/chat/completions

# Timeouts de las llamadas upstream (ms). Opcionales; por defecto entre paréntesis.
# ANTHROPIC_TIMEOUT_MS=60000     # (60 s) llamada hosted
# OLLAMA_TIMEOUT_MS=300000       # (5 min) inferencia local, más lenta

# Control de concurrencia (P03 / modelo X02). Opcionales; por defecto entre paréntesis.
# MAX_GLOBAL_INFLIGHT=24         # tope global de llamadas upstream simultáneas
# MAX_USER_INFLIGHT=3            # tope por usuario; el resto va a la cola
# MAX_QUEUE=100                  # profundidad de la cola FIFO; llena → 503 + Retry-After
# QUEUE_TIMEOUT_MS=10000         # (10 s) espera máx. en cola → 503 + Retry-After
# DRAIN_TIMEOUT_MS=25000         # (25 s) ventana de drenaje al apagar
# UPSTREAM_MAX_SOCKETS=64        # tamaño del pool keep-alive hacia el upstream

# Validación de entrada y límites (P04). Opcionales; por defecto entre paréntesis.
# BODY_LIMIT=1mb                 # tamaño máx. del cuerpo JSON; mayor → 413
# MAX_TOKENS_CAP=8192            # tope de max_tokens aceptado del llamante
# Listas de modelos permitidos (autoritativas en el servidor). CSV; por defecto:
# ALLOWED_ANTHROPIC_MODELS=claude-haiku-4-5,claude-sonnet-4-6,claude-opus-4-8
# ALLOWED_OLLAMA_MODELS=ministral-3-demo,ministral-3b-demo
