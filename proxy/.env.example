# Configuración del proxy — copia a .env y ajusta los valores:
#     cp .env.example .env

# Clave de API de Anthropic — la mantiene el PROXY, nunca el navegador (P01).
# OBLIGATORIA: el proxy no arranca sin ella / Required: the proxy will not start without it.
ANTHROPIC_API_KEY=

# Orígenes permitidos por CORS (P05) — lista separada por comas, coincidencia exacta.
# Un origen que no esté en la lista no recibe cabeceras CORS y su preflight se deniega.
# QLIK_ORIGIN (singular) se sigue admitiendo como respaldo heredado.
QLIK_ORIGINS=https://your-qlik-server

# TLS (P05). En producción usa un certificado firmado por una CA para el hostname del
# proxy; el par autofirmado de ./certs es solo para desarrollo local. Piso de versión TLS.
# TLS_CERT=./certs/localhost3000-cert.pem
# TLS_KEY=./certs/localhost3000-key.pem
# TLS_MIN_VERSION=TLSv1.2        # (TLSv1.2) mínimo; TLSv1.3 si el entorno lo permite

# Límite de tasa por IP (P05) — respaldo grueso por delante de la autenticación.
# RATE_LIMIT_WINDOW_MS=60000     # (60 s) ventana fija
# RATE_LIMIT_MAX=120             # peticiones por IP y ventana; exceso → 429 + Retry-After

# Observabilidad (P06). Si LOG_DIR está definido, el log de app (app.log) y el de
# auditoría (audit.log) se escriben ahí con rotación por tamaño; si no, van a stdout
# (para un recolector de logs / el servicio de Windows).
# Verbosidad del log de app. Uno de: ERROR (solo errores) · WARN (errores + avisos,
# incl. rechazos 400/403) · INFO (además una línea por petición atendida) · DEBUG
# (además la traza de cada llamada al upstream). El log de AUDITORÍA no se ve afectado
# (siempre se escribe). Por defecto INFO. En pruebas usa DEBUG.
LOG_LEVEL=DEBUG
# LOG_DIR=./logs
# LOG_MAX_BYTES=10485760         # (10 MB) tamaño máx. por archivo antes de rotar
# LOG_MAX_FILES=5                # nº de archivos rotados que se conservan

# Autenticación del llamante (P02) — el proxy valida la sesión Qlik del navegador
# contra la API de Qlik (QPS) por TLS mutuo, y resuelve la identidad del usuario.
# OBLIGATORIAS para /api/*: el proxy no arranca sin ellas.
# IMPORTANTE: el HOST de QLIK_SESSION_URL debe coincidir con un SAN del certificado
# que presenta QPS (4243), o Node rechaza el TLS (ERR_TLS_CERT_ALTNAME_INVALID). En
# QSEoW el certificado suele llevar el nombre CORTO de la máquina (p. ej. MIHOST-01),
# no el FQDN. El proxy añade automáticamente el xrfkey que QPS exige (query + cabecera
# X-Qlik-Xrfkey); sin él QPS responde 403 "XSRF prevention check failed".
QLIK_SESSION_URL=https://your-qlik-host:4243/qps/session     # host = SAN del cert de QPS
QLIK_CERT=./certs/client.pem                                  # certificado de cliente Qlik
QLIK_KEY=./certs/client_key.pem                               # clave privada del certificado
QLIK_CA=./certs/root.pem                                      # CA de Qlik (opcional)
# TTL de la caché de validaciones positivas (ms). Opcional; por defecto 60000.
# QLIK_AUTH_CACHE_TTL_MS=60000
# Nombre de la cookie de sesión Qlik que envía el navegador (flujo same-site). Opcional.
# Por defecto X-Qlik-Session (virtual proxy por defecto). Un virtual proxy con prefijo
# usa X-Qlik-Session-<prefijo>, p. ej. X-Qlik-Session-mkt.
# QLIK_SESSION_COOKIE=X-Qlik-Session

# Puerto del proxy (por defecto 3000)
PORT=3000

# URL del servidor Ollama local (endpoint compatible con OpenAI) para el modelo local.
# Usado por la ruta /api/ollama. Por defecto: http://localhost:11434/v1/chat/completions
OLLAMA_URL=http://localhost:11434/v1/chat/completions

# Timeouts de las llamadas upstream (ms). Opcionales; por defecto entre paréntesis.
# ANTHROPIC_TIMEOUT_MS=60000     # (60 s) llamada hosted
# OLLAMA_TIMEOUT_MS=300000       # (5 min) inferencia local, más lenta

# Control de concurrencia (P03 / modelo X02). Opcionales; por defecto entre paréntesis.
# MAX_GLOBAL_INFLIGHT=24         # tope global de llamadas upstream simultáneas
# MAX_USER_INFLIGHT=3            # tope por usuario; el resto va a la cola
# MAX_QUEUE=100                  # profundidad de la cola FIFO; llena → 503 + Retry-After
# QUEUE_TIMEOUT_MS=10000         # (10 s) espera máx. en cola → 503 + Retry-After
# DRAIN_TIMEOUT_MS=25000         # (25 s) ventana de drenaje al apagar
# UPSTREAM_MAX_SOCKETS=64        # tamaño del pool keep-alive hacia el upstream

# Validación de entrada y límites (P04). Opcionales; por defecto entre paréntesis.
# BODY_LIMIT=1mb                 # tamaño máx. del cuerpo JSON; mayor → 413
# MAX_TOKENS_CAP=8192            # tope de max_tokens aceptado del llamante
# Listas de modelos permitidos (autoritativas en el servidor). CSV; por defecto:
# ALLOWED_ANTHROPIC_MODELS=claude-haiku-4-5,claude-sonnet-5,claude-opus-5
# ALLOWED_OLLAMA_MODELS=ministral-3-demo,ministral-3b-demo
