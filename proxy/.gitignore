# Dependencies
node_modules/
npm-debug.log*

# node-windows service wrapper artifacts (per-machine exe + logs, generated by
# service/install-service.js — never committed, never portable across hosts).
daemon/

# Certificates — generated locally, never committed. A private key has no
# business in a repo, and a localhost cert is useless to anyone else anyway.
certs/*.pem

# Environment
.env
*.env

# macOS
.DS_Store

# Logs
*.log
