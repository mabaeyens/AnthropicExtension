# macOS
.DS_Store
.AppleDouble
.LSOverride

# API keys / secretos
.env
*.env

# Node (por si se añade proxy en el futuro)
node_modules/
npm-debug.log*

# VS Code
.vscode/

# Logs
*.log

# Build artifacts (regenerate with package.ps1)
AnthropicExtension-v*.zip
_staging/

# Python (doc build scripts)
__pycache__/
*.pyc

# Generated documentation. Only the PDFs under docs/ are versioned; the editable
# Word sources are regenerated locally via scripts/build-docs-es.py and not tracked.
# (Also ignores any stray root-level docx/pdf builds — docs live only in docs/.)
*.docx
/*.pdf

# Claude Code local files (kept locally, not shipped in the repo)
.claude/
CLAUDE.md

# Hardening specs — local working documents, not shipped in the repo
specs/
